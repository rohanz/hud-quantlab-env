FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV HUD_TELEMETRY_ENABLED=false \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Unprivileged runtime user. The code and .venv stay root-owned and read-only to it;
# nothing is written under /hud at runtime.
RUN useradd --create-home --uid 1000 app

WORKDIR /hud

# Dependencies first, so code changes do not reinstall them.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# The project itself, installed into .venv (fixture included as package data).
COPY . .
RUN uv sync --frozen --no-dev --no-editable

# Run the installed hud directly: nothing is built or synced at start.
ENV PATH="/hud/.venv/bin:$PATH"
USER app
EXPOSE 8765

# Port 8765 is hud's newline-delimited JSON-RPC control channel, not HTTP. A `hello`
# opens a session without starting a task, so it is a side-effect-free liveness probe.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import json, socket; s = socket.create_connection(('127.0.0.1', 8765), timeout=4); s.sendall(b'{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"hello\"}\\n'); r = json.loads(s.makefile().readline()); s.close(); assert 'session_id' in r['result']"]

CMD ["hud", "serve", "env.py", "--host", "0.0.0.0", "--port", "8765"]
